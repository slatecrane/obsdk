# Atruvia XS2A sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# No registration and no mTLS: every request is signed with a QSealC. Self-signed certificates are
# refused (the sandbox checks them with the EU DSS), so this needs a PSD2 *test* QSealC from a trust
# centre, e.g. Bundesdruckerei (https://www.bundesdruckerei.de/de/PSD2).
# Test users, PIN/TAN, IBANs and mocked consents are in docs/atruvia.md.

OBSDK_BANK=atruvia
OBSDK_COUNTRY=DE
OBSDK_ENV=sandbox

# The sandbox's test IBANs use bank code 49999960; every code reaches the same sandbox host.
OBSDK_EXTRA=bank_code=49999960

# Required by obdev's config; Atruvia has no OAuth client or redirect.
OBSDK_CLIENT_ID=none
OBSDK_REDIRECT_URL=https://example.com/cb

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/atruvia/sandbox.session.json

# Request signing: the test QSealC's RSA key and certificate (PEM). Leave OBSDK_SEAL_KID empty: the
# keyId is built from the certificate (serial and URL-encoded issuer).
OBSDK_SEAL_KEY=banks/atruvia/cert/qseal.key
OBSDK_SEAL_CERT=banks/atruvia/cert/qseal.pem
OBSDK_SEAL_KID=

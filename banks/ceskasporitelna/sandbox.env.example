# Česká spořitelna sandbox. Copy to sandbox.env, which git ignores, and fill in.
#
# Free: sign up on https://developers.erstegroup.com (choose "Solo"; no company or licence asked), create an
# application with usage "Third Party Provider", connect it to Česká spořitelna with the APIs "PSD2 - Account
# Information API v4" and "PSD2 - Payment Initiation API v4", turn on OAuth2 (code grant) with the sandbox redirect
# URI below, and generate the sandbox credentials. Copy the API key into api_key, the client id and secret below.
# The same page lists a sample PSD2 QWAC for the sandbox: download its certificate and private key into
# banks/ceskasporitelna/cert/ (git ignores it) as sandbox-qwac.pem and sandbox-qwac.key.

OBSDK_BANK=ceskasporitelna
OBSDK_COUNTRY=CZ
OBSDK_ENV=sandbox

OBSDK_EXTRA=api_key=
OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
# Must be one of the application's sandbox redirect URIs; nothing has to answer there.
OBSDK_REDIRECT_URL=https://www.example.com/cb

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/ceskasporitelna/sandbox.session.json

OBSDK_TLS_CERT=banks/ceskasporitelna/cert/sandbox-qwac.pem
OBSDK_TLS_KEY=banks/ceskasporitelna/cert/sandbox-qwac.key
# ČS's gateway asks for the client certificate by renegotiating TLS.
OBSDK_TLS_RENEGOTIATE=1

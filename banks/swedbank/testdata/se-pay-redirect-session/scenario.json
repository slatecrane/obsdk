  "config": {
    "bank": "swedbank",
    "country": "SE",
    "env": "sandbox",
    "now": "2026-10-14T12:00:00Z",
    "redirect_url": "https://app.example/cb",
    "ids": {
      "request": [
        "request-1",
        "request-2",
        "request-3",
        "request-4",
        "request-5",
        "request-6",
        "request-7",
        "request-8",
        "request-9",
        "request-10",
        "request-11",
        "request-12",
        "request-13",
        "request-14"
      ],

# Swedbank sandbox: what obdev and the live tests need.
#
#   cp banks/swedbank/sandbox.env.example banks/swedbank/sandbox.env   # never committed
#   # fill in the values, then:
#   set -a; . banks/swedbank/sandbox.env; set +a
#   go run ./cmd/obdev connect -method decoupled
#
# Portal: https://developer.swedbank.com  (your app -> APIs tab)
# Guide:  docs/swedbank.md

OBSDK_BANK=swedbank
OBSDK_COUNTRY=SE
OBSDK_ENV=sandbox

# App: "API key" is the client id, "shared secret" the client secret.
OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
# Registered on the app (also checked in decoupled login).
OBSDK_REDIRECT_URL=http://localhost/cb

OBSDK_SESSION_FILE=banks/swedbank/sandbox.session.json
# Consents are refused without these.
OBSDK_PSU_IP=127.0.0.1
OBSDK_PSU_USER_AGENT=obdev/0.1

# The app must have the PSD2sandbox OAuth scope and be subscribed to every API
# product the flow touches (login, token, consents, accounts). No certificates
# and no test user: sandbox Mobile BankID approves immediately.

# Nordea sandbox: what obdev and the live tests need.
#
#   cp banks/nordea/sandbox.env.example banks/nordea/sandbox.env   # never committed
#   set -a; . banks/nordea/sandbox.env; set +a
#   go run ./cmd/obdev connect
#
# Portal: https://developer.nordeaopenbanking.com (sign up -> My apps -> create an app,
# subscribe it to the Personal/Business Accounts and Payments APIs).
# Guide:  docs/nordea.md

OBSDK_BANK=nordea
OBSDK_COUNTRY=FI            # FI, SE, DK or NO
OBSDK_ENV=sandbox
# OBSDK_SEGMENT=business    # personal (default) or business

# My apps -> your app: client id and client secret.
OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
# The redirect URL registered on the app.
OBSDK_REDIRECT_URL=https://example.com

# Request signing. Download the sandbox QSealC from the portal (the zip with
# QSealC-NordeaDevPortal-*.p12, password 1111) into banks/nordea/ and extract:
#   openssl pkcs12 -legacy -in <p12> -passin pass:1111 -nocerts -nodes | openssl pkey -out banks/nordea/sandbox-signing.key
#   openssl x509 -inform der -in <cer> -out banks/nordea/sandbox-signing.pem
# (*.key, *.pem, *.zip and banks/*/cert/ are ignored by git.)
OBSDK_SEAL_KEY=banks/nordea/sandbox-signing.key
OBSDK_SEAL_CERT=banks/nordea/sandbox-signing.pem

OBSDK_SESSION_FILE=banks/nordea/sandbox.session.json
OBSDK_PSU_IP=127.0.0.1
OBSDK_PSU_USER_AGENT=obdev/0.1

# No test user: the sandbox's POST /authorize redirects straight back with a
# code (obdev prints that URL; paste it back as the callback). Payments sign
# on a mock page that redirects back by itself (follow the printed URL).

# KBC PSD2 sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# No portal registration: the sandbox only needs a QWAC. Without a live one, mail
# developer@kbc.be for KBC's shared test QWAC and private key (see docs/kbc.md).
# The same sandbox serves the kbc, cbc and kbcbrussels bank keys.

OBSDK_BANK=kbc
OBSDK_COUNTRY=BE
OBSDK_ENV=sandbox

# The organizationIdentifier of the QWAC (e.g. PSDBE-NBB-0123456789):
#   openssl x509 -in banks/kbc/cert/qwac.pem -noout -subject -nameopt multiline | grep -i organizationIdentifier
OBSDK_CLIENT_ID=
# Sent as TPP-Redirect-URI and redirect_uri; any HTTPS URL you can copy the callback from.
OBSDK_REDIRECT_URL=https://example.com/cb

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/kbc/sandbox.session.json

# mTLS: the test QWAC and key from KBC.
OBSDK_TLS_CERT=banks/kbc/cert/qwac.pem
OBSDK_TLS_KEY=banks/kbc/cert/qwac.key

# Login on the sandbox's own pages: the dummy users come with the test certificate.
SANDBOX_USER_ID=
SANDBOX_USER_PASSWORD=

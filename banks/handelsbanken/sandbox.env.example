# Handelsbanken sandbox: what obdev and the live tests need.
#
#   cp banks/handelsbanken/sandbox.env.example banks/handelsbanken/sandbox.env   # never committed
#   set -a; . banks/handelsbanken/sandbox.env; set +a
#   go run ./cmd/obdev connect
#
# Portal: https://developer.handelsbanken.com/api/sandbox/signup (create an account -> Apps ->
# Create new app with one redirect URI; subscribe the app to Consents, Accounts, Card Accounts and
# Payments). No certificate is needed in the sandbox.
# Guide:  docs/handelsbanken.md

OBSDK_BANK=handelsbanken
OBSDK_COUNTRY=SE            # SE, GB, NL or LU
OBSDK_ENV=sandbox
# OBSDK_SEGMENT=business    # personal (default) or business

# Apps -> your app: the client id (32 hex digits in the sandbox). No secret is used.
OBSDK_CLIENT_ID=
# The one redirect URI registered on the app. The sandbox redirects to it at once.
OBSDK_REDIRECT_URL=https://example.com

# The sandbox user stands in for the login (X-Sandbox-User; BankID psu_id). Pick one from the test
# data document (developer.handelsbanken.com/api/sandbox/geninfo), matching country and segment:
# SANDBOX-INDIVIDUAL-SE-1..3, SANDBOX-CORPORATE-SE-1..3, ...-GB-*, ...-NL-*, SANDBOX-INDIVIDUAL-LU-*.
OBSDK_EXTRA=sandbox_user=SANDBOX-INDIVIDUAL-SE-1

OBSDK_SESSION_FILE=banks/handelsbanken/sandbox.session.json
OBSDK_PSU_IP=127.0.0.1
OBSDK_PSU_USER_AGENT=obdev/0.1

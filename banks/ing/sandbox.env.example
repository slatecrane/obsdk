# ING sandbox: what obdev and the live tests need.
#
#   cp banks/ing/sandbox.env.example banks/ing/sandbox.env   # never committed
#   set -a; . banks/ing/sandbox.env; set +a
#   go run ./cmd/obdev connect
#
# No account or registration is needed: ING's sandbox runs a pre-registered
# app with public example eIDAS certificates. Download the four files from
# https://developer.ing.com/openbanking/resources/get-started/psd2 (Sandbox ->
# Step 1) into banks/ing/ (*.cer and *.key are ignored by git).
# Guide: docs/ing.md

OBSDK_BANK=ing
OBSDK_COUNTRY=NL
OBSDK_ENV=sandbox

# Pre-registered sandbox app for the example certificates.
OBSDK_CLIENT_ID=5ca1ab1e-c0ca-c01a-cafe-154deadbea75
# The consent page accepts https://www.example.com/ (not https://example.com,
# although the app metadata lists that one).
OBSDK_REDIRECT_URL=https://www.example.com/

# mTLS with the example QWAC.
OBSDK_TLS_CERT=banks/ing/example_client_tls.cer
OBSDK_TLS_KEY=banks/ing/example_client_tls.key

# X-JWS-Signature with the example QSealC (identified by its SHA-256 fingerprint).
OBSDK_SEAL_KEY=banks/ing/example_client_signing.key
OBSDK_SEAL_CERT=banks/ing/example_client_signing.cer

OBSDK_SESSION_FILE=banks/ing/sandbox.session.json
OBSDK_PSU_IP=127.0.0.1
OBSDK_PSU_USER_AGENT=obdev/0.1

# No test user to log in with: ING's sandbox consent page lists test profiles
# per country (e.g. NL "Hr A van Dijk , Mw B Mol-van Dijk"); pick one.

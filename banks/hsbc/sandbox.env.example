# HSBC sandbox: what obdev and the live tests need.
#
#   cp banks/hsbc/sandbox.env.example banks/hsbc/sandbox.env   # never committed
#   # fill in the values, then:
#   set -a; . banks/hsbc/sandbox.env; set +a
#   go run ./cmd/obdev connect
#
# Portal: https://developer.hsbc.com/web-hub  (Open Banking -> create a project, UK and Europe)
# Guide:  docs/hsbc.md

OBSDK_BANK=hsbc             # hsbc, firstdirect or mandsbank
OBSDK_COUNTRY=GB            # GB, or MT for HSBC Malta (bank hsbc only)
OBSDK_ENV=sandbox
# OBSDK_SEGMENT=business    # HSBC UK Business (bank hsbc, GB)

# Key and certificates. Generate a key and a CSR, give the CSR to the project
# wizard, and download the transport and signing certificates it issues:
#   openssl genrsa -out banks/hsbc/private.key 2048
#   openssl req -new -sha256 -key banks/hsbc/private.key -out banks/hsbc/eidas.csr
# (*.key and banks/*/cert/ are ignored by git.)
OBSDK_TLS_CERT=banks/hsbc/cert/transport.crt
OBSDK_TLS_KEY=banks/hsbc/private.key
OBSDK_SEAL_KEY=banks/hsbc/private.key
OBSDK_SEAL_CERT=banks/hsbc/cert/signing.crt
# The kid registered for the signing certificate: its Subject Key Identifier,
# upper-case hex without colons:
#   openssl x509 -in banks/hsbc/cert/signing.crt -noout -ext subjectKeyIdentifier
OBSDK_SEAL_KID=

# The project's client id (one registration works for every brand).
OBSDK_CLIENT_ID=
# A redirect URI from the software statement.
OBSDK_REDIRECT_URL=https://example.com

OBSDK_SESSION_FILE=banks/hsbc/sandbox.session.json
OBSDK_PSU_IP=127.0.0.1
OBSDK_PSU_USER_AGENT=obdev/0.1

# Sandbox test users (security code 123456). Not read by any code: you type
# them on HSBC's login page. customer01 HSBC UK, customer02 first direct,
# customer03 M&S Bank, customer04 HSBC UK Business, customer35 HSBC Malta.
# The callback (https://example.com/#code=...) must be pasted within a minute.

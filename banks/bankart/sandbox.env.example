# Bankart sandbox (NLB, OTP banka, Banka Sparkasse, Gorenjska banka, DBS, Hranilnica LON, PH Vipava). Copy to
# sandbox.env, which git ignores, and fill in.
#
# Free: create an account on the bank's portal, e.g. https://openbanking.bankart.si/nlb/user/register, then
# Apps -> Create New App (OAuth Redirect URL below, no certificate) and subscribe the app to the
# "Account Information (Sandbox)" and "Payment initiation (Sandbox)" products. The app's client id and
# secret go below (the secret is shown once). No certificates; the sandbox answers with static data.

OBSDK_BANK=nlb
OBSDK_COUNTRY=SI
OBSDK_ENV=sandbox

OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
OBSDK_REDIRECT_URL=https://example.com/callback

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/bankart/sandbox.session.json

# SIBS API Market sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# Free: register on https://developer.sibsapimarket.com/sandbox (e-mail activation), create an app
# (Apps -> Create New App) and subscribe it to the free sandbox plans of the Accounts, Payments and
# Information Product (List of Banks) products. No certificates: the sandbox has no mTLS and doesn't
# check signatures. Static data, the same for every bank.

OBSDK_BANK=sibs
OBSDK_COUNTRY=PT
OBSDK_ENV=sandbox

# The bank's ASPSP code (List of Banks API), e.g. BST (Santander Totta).
OBSDK_EXTRA=aspsp=BST

# The app's client id from the portal (sent as X-IBM-Client-Id). The secret isn't used.
OBSDK_CLIENT_ID=
OBSDK_REDIRECT_URL=https://www.example.com/callback

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/sibs/sandbox.session.json

# SIBS's gateway renegotiates TLS after the handshake; Go refuses that unless allowed.
OBSDK_TLS_RENEGOTIATE=1

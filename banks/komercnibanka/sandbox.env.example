# Komerční banka PSD2 sandbox. Copy to sandbox.env, which git ignores.
#
# Free: register on https://developers.kb.cz (no licence or company needed) and log in. Open the service
# "OAuth2 for PSD2 API CZ Sandbox v1" → "PSD2 Sandbox Test Certificate" and download the certificate (a .p12;
# its password is printed on the same page). Save it in banks/komercnibanka/cert/, which git ignores, and
# split it into PEM files:
#   openssl pkcs12 -legacy -in sandbox.p12 -nokeys -clcerts -out cert.pem
#   openssl pkcs12 -legacy -in sandbox.p12 -nocerts -nodes -out key.pem
# The client id and secret are not checked in the sandbox, and its login page only asks for a test client
# name (any text). KB's signing page needs an https redirect URL; nothing has to answer there.

OBSDK_BANK=komercnibanka
OBSDK_COUNTRY=CZ
OBSDK_ENV=sandbox

OBSDK_CLIENT_ID=obsdk-sandbox-client
OBSDK_REDIRECT_URL=https://www.example.com/cb
OBSDK_EXTRA=tpp_name=obsdk

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/komercnibanka/sandbox.session.json

OBSDK_TLS_CERT=banks/komercnibanka/cert/cert.pem
OBSDK_TLS_KEY=banks/komercnibanka/cert/key.pem
# KB's gateway renegotiates TLS to ask for the client certificate.
OBSDK_TLS_RENEGOTIATE=1

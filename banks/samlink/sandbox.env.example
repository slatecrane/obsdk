# Samlink sandbox (Säästöpankki, Oma Säästöpankki). Copy to sandbox.env, which git ignores, and fill in.
#
# Free: sign up on https://developer.samlink.fi, subscribe to the APIs (Get Started -> Subscribe) and copy
# the subscription key from the Profile page. Then register a sandbox application once (gives client id
# and secret):
#   curl -X POST https://sml-prod-psd2.azure-api.net/mngmt/management/tpp-register-app \
#     -H "Ocp-Apim-Subscription-Key: $KEY" -H 'Content-Type: application/json' \
#     -d '{"client_name":"obsdk","client_description":"obsdk","redirect_uris":["https://www.example.com/callback"]}'
# No certificates. Test users: OmaSPSandbox Customer-01/02 (omasp), SPSandbox Customer-01/02 (saastopankki).

OBSDK_BANK=saastopankki
OBSDK_COUNTRY=FI
OBSDK_ENV=sandbox

OBSDK_EXTRA=subscription_key=
OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
OBSDK_REDIRECT_URL=https://www.example.com/callback

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/samlink/sandbox.session.json

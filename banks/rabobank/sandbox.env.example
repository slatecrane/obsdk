# Rabobank sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# Portal: https://developer.rabobank.com (sign up for Sandbox) → My organizations →
# your sandbox organization → Apps → Register app. The client secret is shown once.
# On the app: subscribe to "OAuth 2.0 Services", the Account Information APIs
# (Accounts, Balances, Transactions) and "Single Payment Initiation"; set the
# OAuth redirect URI below; upload the mTLS certificate under Configuration.

OBSDK_BANK=rabobank
OBSDK_COUNTRY=NL
OBSDK_ENV=sandbox

# App → Details (client id) and the secret shown once at registration.
OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
# Must equal the app's OAuth redirect URI.
OBSDK_REDIRECT_URL=https://example.com/cb

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/rabobank/sandbox.session.json

# mTLS: the sandbox accepts any certificate. Rabobank's example (docs → PSD2 →
# "How to use mutual TLS"): mTLS-cert.pem / mTLS-key.pem.
OBSDK_TLS_CERT=banks/rabobank/cert/tls.pem
OBSDK_TLS_KEY=banks/rabobank/cert/tls.key

# Request signing: Rabobank's example signing certificate (docs → PSD2 →
# Account Information → "Get the signing certificate"). keyId is the
# certificate's serial number, read from the certificate.
OBSDK_SEAL_KEY=banks/rabobank/cert/signing.key
OBSDK_SEAL_CERT=banks/rabobank/cert/signing.pem

# ABN AMRO sandbox. Copy to sandbox.env, which git ignores, and fill in.
#
# Free: sign up on https://developer.abnamro.com, activate the account from the e-mail, then click your name →
# Apps → Add app with "Account Information (PSD2)" and "Payment Initiation (PSD2)". Copy the app's API key into
# api_key below. Everything else is shared by all sandbox users and published in the API tutorials:
# client id TPP_test, the fixed redirect https://localhost/auth, and the mTLS certificate and key
# (developer.abnamro.com/sites/default/files/2020-05/PSD2TPPCertificate.crt and PSD2TPPprivateKey.key;
# save them in banks/abnamro/cert/, which git ignores).

OBSDK_BANK=abnamro
OBSDK_COUNTRY=NL
OBSDK_ENV=sandbox

OBSDK_EXTRA=api_key=
OBSDK_CLIENT_ID=TPP_test
# The sandbox accepts no other redirect URL.
OBSDK_REDIRECT_URL=https://localhost/auth

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/abnamro/sandbox.session.json

OBSDK_TLS_CERT=banks/abnamro/cert/PSD2TPPCertificate.crt
OBSDK_TLS_KEY=banks/abnamro/cert/PSD2TPPprivateKey.key

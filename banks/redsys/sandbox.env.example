# Redsys PSD2 hub sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# Free: create an account on https://market.apis-i.redsys.es/psd2/xs2a/user/register, create an
# application (a title is enough) and subscribe to a plan (confirmed by e-mail, usually within a day).
# The portal's "Certificates" tab gives a generic sandbox certificate: save its key and certificate (PEM)
# under banks/redsys/cert/ (ignored). No mTLS.
# Simulated bank login: user1 / 1234 (SCA OK), user2 / 1234 (SCA KO). Test IBANs: docs/redsys.md.

OBSDK_BANK=redsys
OBSDK_COUNTRY=ES
OBSDK_ENV=sandbox

# The bank's code on the hub: BBVA, caixabank, BancSabadell, bancosantander, ...
OBSDK_EXTRA=aspsp=BBVA

# The OAuth client id: the certificate's organizationIdentifier (e.g. PSDES-BDE-3DFD21), shown by
# `openssl x509 -in banks/redsys/cert/qseal.pem -noout -subject`. obdev needs it set; the SDK itself
# reads it from the certificate when Credentials.ClientID is empty.
OBSDK_CLIENT_ID=
OBSDK_REDIRECT_URL=https://www.example.com/callback

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/redsys/sandbox.session.json

# Request signing: the generic certificate's RSA key and certificate (PEM). Leave OBSDK_SEAL_KID empty:
# the keyId is built from the certificate (serial and issuer).
OBSDK_SEAL_KEY=banks/redsys/cert/qseal.key
OBSDK_SEAL_CERT=banks/redsys/cert/qseal.pem
OBSDK_SEAL_KID=

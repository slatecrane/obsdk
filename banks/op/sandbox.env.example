# OP Financial Group sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# 1. Sign up at https://op-developer.fi and create an app with the products
#    "OP PSD2 Account Information Service API" and "OP PSD2 Payment Initiation
#    Service API". Its API key goes in OP_API_KEY.
# 2. Let OP generate sandbox certificates and register a client (writes keys
#    and certificates to banks/op/cert/, prints every OBSDK_ value below):
#
#      OP_API_KEY=... go run ./banks/op/sandboxsetup -redirect https://example.com/cb
#
#    OP deletes generated sandbox TPPs now and then; run it again when the
#    sandbox refuses the certificate.
#
# Guide: docs/op.md

OP_API_KEY=

OBSDK_BANK=op
OBSDK_COUNTRY=FI
OBSDK_SEGMENT=personal
OBSDK_ENV=sandbox

# From sandboxsetup (the registration response).
OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
OBSDK_REDIRECT_URL=https://example.com/cb

# Generated by OP: QWAC for mTLS, QSealC for the request object and payment signatures.
OBSDK_TLS_CERT=banks/op/cert/qwac.pem
OBSDK_TLS_KEY=banks/op/cert/qwac.key
OBSDK_SEAL_KEY=banks/op/cert/qseal.key
OBSDK_SEAL_CERT=banks/op/cert/qseal.pem
OBSDK_SEAL_KID=

# api_key = OP_API_KEY (sent as x-api-key on every API call).
OBSDK_EXTRA=api_key=

OBSDK_SESSION_FILE=banks/op/sandbox.session.json
OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1

# Sandbox test users (typed into OP's login page, not read by any code):
# username 88888881 or 88888882, password 1122, key code / mobile key 1122.

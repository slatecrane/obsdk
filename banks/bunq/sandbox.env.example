# bunq sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# bunq's sandbox has no portal and needs no certificates: users, their API
# keys and an OAuth client are made through the API. This prints every value
# below (it creates two sandbox users and gives the test user €500):
#
#   go run ./banks/bunq/sandboxsetup
#
# OAuth consent (method redirect) needs the bunq sandbox app for Android
# (https://doc.bunq.com/getting-started/tools/android-emulator) logged in as a
# sandbox user that never made an API call; method api_key does not.

OBSDK_BANK=bunq
OBSDK_COUNTRY=NL
OBSDK_SEGMENT=personal
OBSDK_ENV=sandbox

# The OAuth client of the "app owner" sandbox user (GET /user/{id}/oauth-client).
OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
# A callback URL registered on the OAuth client.
OBSDK_REDIRECT_URL=http://localhost/cb

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/bunq/sandbox.session.json

# Any RSA key: openssl genrsa -out banks/bunq/cert/installation.key 2048
OBSDK_SEAL_KEY=banks/bunq/cert/installation.key

# Test user. Connect with: go run ./cmd/obdev connect -method api_key
# and enter SANDBOX_USER_API_KEY. In the sandbox app: log in with the phone
# number or e-mail, passcode 000000 (or 992266).
SANDBOX_USER_API_KEY=
SANDBOX_USER_PHONE=
SANDBOX_USER_EMAIL=
SANDBOX_USER_PASSCODE=000000

# The sandbox user that owns the OAuth client.
SANDBOX_OAUTH_OWNER_API_KEY=

# Coop Pank sandbox. Copy to sandbox.env, which git ignores, and fill in.
#
# Free: register on https://openbanking.cooppank.ee, add a sandbox application under My Apps (redirect URI
# https://example.com/callback; the certificate step can be skipped) and copy its API key into api_key.
# No certificates. Test users are listed under My Sandbox (PSU 1 obcoop1, PSU 2 obcoop2).

OBSDK_BANK=cooppank
OBSDK_COUNTRY=EE
OBSDK_ENV=sandbox

OBSDK_EXTRA=api_key=
# Not used by Coop Pank, but obdev wants one.
OBSDK_CLIENT_ID=none
OBSDK_REDIRECT_URL=https://example.com/callback

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/cooppank/sandbox.session.json

# Revolut sandbox: what obdev and the live tests need.
#
#   cp banks/revolut/sandbox.env.example banks/revolut/sandbox.env   # never committed
#   # fill in the values, then:
#   set -a; . banks/revolut/sandbox.env; set +a
#   go run ./cmd/obdev connect
#
# Portal: https://developer.revolut.com/portal  (app -> Sandbox)
# Guide:  docs/revolut.md

OBSDK_BANK=revolut
OBSDK_COUNTRY=GB
OBSDK_ENV=sandbox

# App -> Overview: sandbox client id.
OBSDK_CLIENT_ID=
# App -> Sandbox authentication -> Redirect URLs (must match exactly).
OBSDK_REDIRECT_URL=https://example.com

# Transport (mTLS). Generate private.key + CSR with the command the portal
# suggests, upload the CSR, then "Download sandbox certificates".
OBSDK_TLS_CERT=banks/revolut/transport.der
OBSDK_TLS_KEY=banks/revolut/private.key
# Public root of the sandbox server certificate (committed with the package).
OBSDK_TLS_CA=banks/revolut/openbanking-preprod-root.crt

# Request-object signing. The same private.key signs; Revolut checks the
# signature against the JWKS URL set in the portal, whose key has this kid.
OBSDK_SEAL_KEY=banks/revolut/private.key
OBSDK_SEAL_CERT=banks/revolut/signing.der
OBSDK_SEAL_KID=

OBSDK_SESSION_FILE=banks/revolut/sandbox.session.json
OBSDK_PSU_IP=127.0.0.1
OBSDK_PSU_USER_AGENT=obdev/0.1

# Sandbox test user (portal -> Sandbox -> test users). Not read by any code:
# you type these into Revolut's login page when obdev prints the consent URL.
SANDBOX_USER_PHONE=
SANDBOX_USER_PASSCODE=

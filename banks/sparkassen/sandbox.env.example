# Sparkassen (Finanz Informatik) XS2A sandbox (copy to sandbox.env, which git ignores, and fill in).
#
# No registration: the sandbox only needs a PSD2 *test* QWAC from a trust centre Finanz Informatik
# lists (e.g. Bundesdruckerei). Documentation package: https://www.starfinanz.de/services/xs2a/
# Test users, PINs, TANs and IBANs are in docs/sparkassen.md.

OBSDK_BANK=sparkassen
OBSDK_COUNTRY=DE
OBSDK_ENV=sandbox

# The sandbox's test IBANs use bank code 99999999.
OBSDK_EXTRA=bank_code=99999999

# Redirect approach only (OAuth SCA): the QWAC's organizationIdentifier (e.g. PSDDE-BAFIN-123456):
#   openssl x509 -in banks/sparkassen/cert/qwac.pem -noout -subject -nameopt multiline | grep -i organizationIdentifier
OBSDK_CLIENT_ID=
# Sent as TPP-Redirect-URI; the user comes back with ?state=…&code=…
OBSDK_REDIRECT_URL=https://example.com/cb

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/sparkassen/sandbox.session.json

# mTLS: the test QWAC and its key.
OBSDK_TLS_CERT=banks/sparkassen/cert/qwac.pem
OBSDK_TLS_KEY=banks/sparkassen/cert/qwac.key

# BNP Paribas Fortis sandbox (also Hello bank! and Fintro). Copy to sandbox.env, which git ignores, and fill in.
#
# Free: register on https://developer.bnpparibasfortis.com (the team reviews new accounts in 1-2 business days),
# add an app under Dashboard > Manage Apps with redirect URI https://example.com/callback, subscribe it to the
# Account Information, Check Availability of Funds and Payment Initiation APIs (psd2/v4) of the brands you need,
# and copy its Client ID and Client Secret Key from the app details. "Generate Test User" on the same page
# creates the test users (user name and password); no certificates.
# Brands: OBSDK_BANK=bnpparibasfortis | hellobank | fintro.

OBSDK_BANK=bnpparibasfortis
OBSDK_COUNTRY=BE
OBSDK_ENV=sandbox

OBSDK_CLIENT_ID=
OBSDK_CLIENT_SECRET=
OBSDK_REDIRECT_URL=https://example.com/callback
OBSDK_EXTRA=initiating_party=obsdk

OBSDK_PSU_IP=203.0.113.7
OBSDK_PSU_USER_AGENT=obdev/0.1
OBSDK_SESSION_FILE=banks/bnpparibasfortis/sandbox.session.json
